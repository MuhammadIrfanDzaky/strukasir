<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: splash sistem memakai ikon adaptif (struk putih di lingkaran indigo) di atas latar terang. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/strukasir_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/strukasir_surface</item>
    </style>
</resources>
