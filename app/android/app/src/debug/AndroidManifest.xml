<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- HANYA build debug: izinkan HTTP ke server dev di laptop (http://<IP-laptop>:8000).
         Build release tidak mewarisi ini, jadi produksi wajib HTTPS. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
