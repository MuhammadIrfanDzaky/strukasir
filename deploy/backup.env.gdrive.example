# Backup ke Google Drive (gratis 15 GB, tanpa kartu kredit). Salin ke deploy/backup.env — JANGAN di-commit.
#
# Token dibuat SEKALI di laptop (butuh browser):
#   1. Pasang rclone di laptop (https://rclone.org/downloads/).
#   2. Jalankan:  rclone authorize "drive" "eyJzY29wZSI6ImRyaXZlLmZpbGUifQ"
#      (scope drive.file = rclone hanya bisa melihat file yang ia buat sendiri, bukan seluruh Drive).
#   3. Login Google di browser, lalu salin JSON token yang muncul ke RCLONE_CONFIG_BACKUP_TOKEN
#      (satu baris, bungkus dengan tanda kutip tunggal).
# Pakai akun Google khusus kedai/bisnis, bukan akun pribadi.
BACKUP_PATH=berrybrew-backup
RCLONE_CONFIG_BACKUP_TYPE=drive
RCLONE_CONFIG_BACKUP_SCOPE=drive.file
RCLONE_CONFIG_BACKUP_TOKEN=
# Hapus permanen backup lama (bukan ke Trash) agar kuota tidak penuh.
RCLONE_DRIVE_USE_TRASH=false
