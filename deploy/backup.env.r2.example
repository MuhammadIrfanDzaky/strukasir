# Backup ke Cloudflare R2 (atau S3 lain). Salin ke deploy/backup.env — JANGAN di-commit.
BACKUP_PATH=berrybrew-backup/postgres
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_BACKUP_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true
