# Salin ke deploy/.env di server (JANGAN di-commit). Isi semua nilai kosong.
# Buat rahasia acak:  openssl rand -base64 24 | tr -dc 'A-Za-z0-9'

# ── Domain & HTTPS ─────────────────────────────────────────────
SERVER_NAME=pos.contoh.my.id
APP_URL=https://pos.contoh.my.id

# ── Laravel ────────────────────────────────────────────────────
APP_NAME="BerryBrew POS"
# php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=id
LOG_LEVEL=warning
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# ── Database (hanya huruf & angka) ─────────────────────────────
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── Backup ─────────────────────────────────────────────────────
# Tujuan backup diatur di deploy/backup.env (salin dari backup.env.r2.example atau
# backup.env.gdrive.example).
BACKUP_RETENTION_DAYS=30
# Opsional: URL ping healthchecks.io agar backup gagal ketahuan
BACKUP_HEARTBEAT_URL=

# ── Versi app tablet ───────────────────────────────────────────
POS_APP_LATEST_VERSION=1.0.0
POS_APP_MIN_VERSION=1.0.0
POS_APP_DOWNLOAD_URL=
