# Salin ke deploy/.env di server (JANGAN di-commit). Isi semua nilai kosong.
# Buat rahasia acak:  openssl rand -base64 24 | tr -dc 'A-Za-z0-9'

# ── Domain & HTTPS ─────────────────────────────────────────────
SERVER_NAME=pos.contoh.my.id
APP_URL=https://pos.contoh.my.id

# ── Laravel ────────────────────────────────────────────────────
APP_NAME="BerryBrew POS"
# php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=id
LOG_LEVEL=warning
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# ── Database (hanya huruf & angka) ─────────────────────────────
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── Backup ─────────────────────────────────────────────────────
# Tujuan backup diatur di deploy/backup.env (salin dari backup.env.r2.example atau
# backup.env.gdrive.example).
BACKUP_RETENTION_DAYS=30
# Opsional: URL ping healthchecks.io agar backup gagal ketahuan
BACKUP_HEARTBEAT_URL=

# ── Versi app tablet ───────────────────────────────────────────
POS_APP_LATEST_VERSION=1.0.0
POS_APP_MIN_VERSION=1.0.0
POS_APP_DOWNLOAD_URL=

# ── Email (kode verifikasi & lupa password) ─────────────────────
# SMTP dari penyedia email transaksional (mis. Brevo/Mailgun). Kosong/log = kode tidak terkirim.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@strukasir.id
MAIL_FROM_NAME="Strukasir"

# ── Pelacak error (Sentry, paket gratis) ───────────────────────
# Kosong = nonaktif. DSN dari proyek "Laravel" di sentry.io. Isi request (password/PIN)
# tidak pernah dikirim; lihat backend/config/sentry.php.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
# 0 = hanya error, tanpa tracing performa (hemat kuota gratis)
SENTRY_TRACES_SAMPLE_RATE=0
